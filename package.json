{
  "name": "@jordonbc/opentmux",
  "version": "1.0.3",
  "description": "OpenCode tmux integration: automatically opens subagent panes and renders real-time agent execution with smart layouts",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "./dist/bin/opentmux.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "postinstall": "test -f dist/scripts/install.js && node dist/scripts/install.js || echo 'Skipping postinstall setup (dist not found)'"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tmux",
    "agent",
    "subagent",
    "visualization"
  ],
  "author": "Jordon Brooks",
  "contributors": ["Angan Samadder"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jordonbc/opentmux.git"
  },
  "bugs": {
    "url": "https://github.com/Jordonbc/opentmux/issues"
  },
  "homepage": "https://github.com/Jordonbc/opentmux#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
